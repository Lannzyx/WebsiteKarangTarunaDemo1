<!DOCTYPE html><html lang="id"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Login Admin</title><link rel="stylesheet" href="/css/style.css"></head>
<body><main class="section"><div class="container" style="max-width:520px;">
  <div class="card">
    <h1>Login Admin</h1>
    <p>Masuk untuk mengelola konten website.</p>
    <% if(error){ %><div class="note" style="background:#fef2f2;border-color:#fecaca;color:#991b1b;"><%= error %></div><% } %>
    <form method="post" action="/admin/login" class="mt-2">
      <div class="form-group"><label>Username atau Email</label><input name="login" required value="<%= login||'' %>"></div>
      <div class="form-group"><label>Password</label><input type="password" name="password" required></div>
      <button class="btn btn-primary btn-block" type="submit">Masuk</button>
    </form>
    <p class="small muted mt-2"><a href="/">&larr; Kembali ke website</a></p>
  </div>
</div></main></body></html>
