<!DOCTYPE html><html lang="id"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= title %> - Admin</title><link rel="stylesheet" href="/css/style.css">
<style>
  .admin-wrap{display:grid;grid-template-columns:240px 1fr;min-height:100vh}
  .admin-side{background:#0A1E3C;color:#e5e7eb;padding:18px 14px}
  .admin-side h2{color:#fff;font-size:1.05rem;margin:0 0 10px}
  .admin-side a{display:block;color:#cbd5e1;padding:10px 12px;border-radius:8px;margin-bottom:4px;text-decoration:none}
  .admin-side a:hover,.admin-side a.active{background:#163a63;color:#fff}
  .admin-main{padding:22px;background:var(--bg)}
  .admin-top{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:18px;flex-wrap:wrap}
  .admin-card{background:#fff;border:1px solid var(--border);border-radius:12px;padding:18px;box-shadow:var(--shadow-sm);margin-bottom:16px}
  .btn-sm{padding:8px 12px;font-size:.92rem}
  .btn-danger{background:#dc2626;color:#fff;border-color:#dc2626}
  .btn-danger:hover{background:#b91c1c;color:#fff}
  .row{display:grid;gap:14px}.row-2{grid-template-columns:1fr 1fr}.row-3{grid-template-columns:1fr 1fr 1fr}
  @media(max-width:900px){.admin-wrap{grid-template-columns:1fr}.row-2,.row-3{grid-template-columns:1fr}}
  .flash{padding:12px 14px;border-radius:10px;margin-bottom:14px}
  .flash.success{background:#ecfdf5;border:1px solid #a7f3d0;color:#065f46}
  .flash.error{background:#fef2f2;border:1px solid #fecaca;color:#991b1b}
  .table-actions{display:flex;gap:8px;flex-wrap:wrap}
  .inline-form{display:inline}
  .mb-0{margin-bottom:0}
</style></head><body><div class="admin-wrap">
<aside class="admin-side">
  <h2>Panel Admin</h2>
  <div class="small" style="margin-bottom:12px;color:#94a3b8">Login: <%= currentAdmin ? currentAdmin.username : '' %></div>
  <nav>
    <% const nav=[['/admin','Dashboard','dashboard'],['/admin/berita','Berita','berita'],['/admin/anggota','Anggota/Pengurus','anggota'],['/admin/jadwal','Jadwal','jadwal'],['/admin/kas','Kas','kas'],['/admin/galeri','Galeri','galeri'],['/admin/pengaturan','Pengaturan','pengaturan'],['/admin/accounts','Akun Admin','accounts']]; %>
    <% nav.forEach(([href,label,key])=>{ %><a class="<%= (typeof active!=='undefined' && active===key)?'active':'' %>" href="<%= href %>"><%= label %></a><% }) %>
    <hr style="border-color:#1e3a5f;border-style:solid;border-width:1px 0 0;margin:10px 0">
    <a href="/admin/password">Ganti Password</a>
    <a href="/" target="_blank">Lihat Website</a>
    <a href="/admin/logout">Logout</a>
  </nav>
</aside>
<main class="admin-main">
<% if(flash){ %><div class="flash <%= flash.type %>"><%= flash.msg %></div><% } %>
